{
  "name": "openheart3d-ecg-web",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "description": "Protótipo web OpenHeart3D ECG 2.0: 12 derivações + coração 3D sincronizado",
  "scripts": {
    "start": "python -m http.server 8000",
    "test": "node --test tests/*.test.mjs && node tests/detector-bench.mjs && node tests/detector-real.mjs",
    "bench": "node tests/detector-bench.mjs",
    "bench:real": "node tests/detector-real.mjs",
    "fetch-data": "node scripts/fetch-records.mjs",
    "pack-vault": "node tools/vault/pack.mjs",
    "unpack-vault": "node tools/vault/unpack.mjs",
    "build-rt": "node tools/vault/build-rt.mjs"
  },
  "devDependencies": {
    "@gltf-transform/core": "^4.5.1",
    "@gltf-transform/extensions": "^4.5.1",
    "@gltf-transform/functions": "^4.5.1",
    "fbx2gltf": "^0.9.7-p1",
    "sharp": "^0.35.5"
  }
}
